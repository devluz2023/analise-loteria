# --- FUNÇÃO PARA CONVERTER ÍNDICE EM 6 NÚMEROS ---
def indice_para_combinacao(index, n=60, k=6):
    """Converte um índice (1-50.063.860) de volta para os 6 números"""
    combinacao = []
    current = 1
    for i in range(k):
        while True:
            c = comb(n - current, k - 1 - i)
            if index <= c:
                combinacao.append(current)
                break
            index -= c
            current += 1
        current += 1
    return combinacao

# 6. Resultado Final
jogo_previsto = indice_para_combinacao(indice_previsto)

