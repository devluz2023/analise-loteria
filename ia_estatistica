import numpy as np
import pandas as pd
import random
from collections import Counter
from sklearn.preprocessing import MinMaxScaler
from get_data import df_mega_sena

# === IMPORTAÇÕES DA SUA LÓGICA OFICIAL ===
from indice import encontrar_posicao_itertools

print("Iniciando Motor do Gerador Estatístico Puro com Backtesting...")
colunas_bolas = ['Bola1', 'Bola2', 'Bola3', 'Bola4', 'Bola5', 'Bola6']
df_cronologico = df_mega_sena.sort_values(by='Concurso').copy()
total_sorteios = len(df_cronologico)

# Separando a base de dados: 80% para base de cálculo e 20% para testar a assertividade
split_idx = int(total_sorteios * 0.8)
df_treino_base = df_cronologico.iloc[:split_idx].copy()
df_teste_validacao = df_cronologico.iloc[split_idx:].copy()

# =============================================================
# 1. FUNÇÃO DA ENGENHARIA ESTATÍSTICA (REUTILIZÁVEL)
# =============================================================
def calcular_universo_elite_historico(df_historico_ponto):
    """
    Calcula o score composto ponderado das dezenas considerando apenas
    o histórico disponível até um determinado ponto do passado.
    """
    sorteios_locais = len(df_historico_ponto)
    
    # Coleta de frequências acumuladas
    todas_dezenas = []
    for index, row in df_historico_ponto.iterrows():
        for col in colunas_bolas:
            todas_dezenas.append(row[col])
    frequencia_dezenas = Counter(todas_dezenas)

    df_freq = pd.DataFrame(frequencia_dezenas.items(), columns=['Dezena', 'Frequencia'])
    # Garante que todas as dezenas de 1 a 60 apareçam, mesmo com frequência zero
    df_completo = pd.DataFrame({'Dezena': range(1, 61)})
    df_freq = pd.merge(df_completo, df_freq, on='Dezena', how='left').fillna(0)

    # Cálculo de Desvios
    media_esp = sorteios_locais / 10
    df_freq['Desvio'] = df_freq['Frequencia'] - media_esp

    # Cálculo de Ausência Atual no ponto histórico
    current_ausencia = {dezena: 0 for dezena in range(1, 61)}
    for index, row in df_historico_ponto.iterrows():
        dezenas_presentes = set([row[col] for col in colunas_bolas])
        for dezena in range(1, 61):
            if dezena in dezenas_presentes:
                current_ausencia[dezena] = 0
            else:
                current_ausencia[dezena] += 1

    df_aus = pd.DataFrame(current_ausencia.items(), columns=['Dezena', 'Ausencia_Atual'])
    df_est = pd.merge(df_freq, df_aus, on='Dezena')

    # Normalização Multi-Critério
    scaler = MinMaxScaler()
    df_est['Ausencia_Norm'] = scaler.fit_transform(df_est[['Ausencia_Atual']])
    df_est['Frequencia_Norm'] = scaler.fit_transform(df_est[['Frequencia']])

    min_desvio = df_est['Desvio'].min()
    df_est['Desvio_Ajustado'] = df_est['Desvio'] - min_desvio
    df_est['Desvio_Norm'] = scaler.fit_transform(df_est[['Desvio_Ajustado']])

    # Pesos Oficiais do seu Gerador
    PESO_AUSENCIA = 0.5
    PESO_FREQ = 0.3
    PESO_DESVIO = 0.2

    df_est['Score_Estatistico'] = (
        (df_est['Ausencia_Norm'] * PESO_AUSENCIA) +
        (df_est['Frequencia_Norm'] * PESO_FREQ) +
        (df_est['Desvio_Norm'] * PESO_DESVIO)
    )

    df_elite_local = df_est.sort_values(by='Score_Estatistico', ascending=False).head(28)
    return df_elite_local['Dezena'].tolist()

def filtrar_cinco_jogos_estatisticos(universo_elite_local):
    """ Filtra e gera 5 jogos estáveis baseados nos critérios de distribuição do seu código """
    jogos_filtrados = []
    tentativas = 0
    while len(jogos_filtrados) < 5 and tentativas < 10000:
        tentativas += 1
        palpite = sorted(random.sample(universo_elite_local, 6))
        
        # Filtro 1: Paridade
        if sum(1 for num in palpite if num % 2 == 0) not in [2, 3, 4]:
            continue
            
        # Filtro 2: Magnitude da Soma (120 a 200)
        if not (120 <= sum(palpite) <= 200):
            continue
            
        # Filtro 3: Evitar mais de duas dezenas consecutivas
        sequencia_longa = False
        for i in range(len(palpite) - 2):
            if palpite[i+1] == palpite[i] + 1 and palpite[i+2] == palpite[i] + 2:
                sequencia_longa = True
                break
        if sequencia_longa:
            continue
            
        if palpite not in jogos_filtrados:
            jogos_filtrados.append(palpite)
            
    return jogos_filtrados


# =============================================================
# 2. FASE DE VALIDAÇÃO HISTÓRICA (BACKTESTING COMPLETO)
# =============================================================
print(f"\n[FASE 2] Executando Backtesting em {len(df_teste_validacao)} concursos do bloco oculto...")

total_ternos, total_quadras, total_quinas, total_senas = 0, 0, 0, 0
total_bilhetes_testados = 0

# Simula o comportamento do algoritmo concurso por concurso da base de teste
for i in range(len(df_teste_validacao)):
    concurso_alvo_teste = df_teste_validacao.iloc[i]
    gabarito_real = set([int(concurso_alvo_teste[col]) for col in colunas_bolas])
    
    # Reconstrói a base histórica até aquele momento exato para evitar vazamento de dados
    df_historico_ponto = df_cronologico[df_cronologico['Concurso'] < concurso_alvo_teste['Concurso']]
    
    # Gera os palpites dinamicamente usando a foto estatística daquele momento
    elite_momento = calcular_universo_elite_historico(df_historico_ponto)
    jogos_gerados_momento = filtrar_cinco_jogos_estatisticos(elite_momento)
    
    for jogo in jogos_gerados_momento:
        total_bilhetes_testados += 1
        acertos = len(set(jogo) & gabarito_real)
        if acertos == 6: total_senas += 1
        elif acertos == 5: total_quinas += 1
        elif acertos == 4: total_quadras += 1
        elif acertos == 3: total_ternos += 1

# CORREÇÃO: Variável unificada para 'total_bilhetes_testados' para mitigar o NameError
taxa_ternos = (total_ternos / total_bilhetes_testados) * 100 if total_bilhetes_testados > 0 else 0
taxa_quadras = (total_quadras / total_bilhetes_testados) * 100 if total_bilhetes_testados > 0 else 0
taxa_quinas = (total_quinas / total_bilhetes_testados) * 100 if total_bilhetes_testados > 0 else 0
taxa_senas = (total_senas / total_bilhetes_testados) * 100 if total_bilhetes_testados > 0 else 0

print("-" * 75)
print(f"RELATÓRIO DEFINITIVO DE PERFORMANCE (MOTOR ESTATÍSTICO PURO):")
print(f"▶ Concursos totais de validação testados: {len(df_teste_validacao)}")
print(f"▶ Total de bilhetes válidos submetidos ao teste: {total_bilhetes_testados}")
print("-" * 75)
print("TAXA PERCENTUAL DE CONVERSÃO HISTÓRICA (HIT RATE):")
print(f"▶ TERNOS:  {total_ternos} acertos ➔ {taxa_ternos:.4f}%  (Esperado acaso: 0.4311%)")
print(f"▶ QUADRAS: {total_quadras} acertos ➔ {taxa_quadras:.4f}%  (Esperado acaso: 0.0428%)")
print(f"▶ QUINAS:  {total_quinas} acertos ➔ {taxa_quinas:.4f}%  (Esperado acaso: 0.0006%)")
print(f"▶ SENAS:   {total_senas} acertos ➔ {taxa_senas:.6f}%  (Esperado acaso: 0.000002%)")
print("-" * 75)


# =============================================================
# 3. GERAÇÃO DOS JOGOS PARA O PRÓXIMO CONCURSO ATUAL
# =============================================================
print("\n[FASE 3] Calculando Universo de Elite definitivo para o PRÓXIMO concurso...")
universo_elite_atual = calcular_universo_elite_historico(df_cronologico)
print(f"➔ Grupo de Elite Atual (TOP 28): {sorted(universo_elite_atual)}")

jogos_definitivos = filtrar_cinco_jogos_estatisticos(universo_elite_atual)

